# Database password (also stored in deploy/.db_password for Docker secrets)
DB_PASSWORD=your-database-password

# JWT secret for signing authentication tokens
JWT_SECRET=your-jwt-secret-change-this

# CORS origin for the leaderboard API (GitHub Pages URL)
CORS_ORIGIN=https://cocodedk.github.io

# SMTP settings for magic link emails (omit all for dev console logging)
SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=your-email@7kasif.dk
SMTP_PASS=your-email-password
SMTP_FROM="Hafte Kasif <noreply@7kasif.dk>"

# Base URL for magic link emails
APP_URL=http://localhost:3000

# Auto-seed admin on first startup (only if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
